# Option 1: Alibaba Cloud DashScope (fixed model: qwen3-8b)
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Option 2: OpenAI-compatible provider (fixed model: Llama 3 8B Instruct)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model names are intentionally fixed in src/llm.py so API calls and
# logging/metadata.json always describe the same <=10B model.

# Optional: force a fully offline, deterministic run.
# LLM_DISABLED=1
